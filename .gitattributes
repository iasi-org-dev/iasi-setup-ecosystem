# IASI corporate baseline: canonical endings by file type
* text=auto

# Cross-platform source and documents
*.java text eol=lf
*.iasi text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.sh text eol=lf
*.gradle text eol=lf
*.properties text eol=lf

# Windows-specific scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Explicit binary examples
*.png binary
*.jpg binary
*.jpeg binary
*.zip binary
*.jar binary
*.vsix binary
